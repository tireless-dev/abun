CREATE TABLE routine (
    id TEXT NOT NULL PRIMARY KEY,
    template_title TEXT NOT NULL,
    template_detail TEXT,
    recurrence_rule TEXT NOT NULL,
    default_start_not_before TEXT,
    default_estimated_duration TEXT,
    is_active INTEGER NOT NULL DEFAULT 1,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    hlc_map TEXT NOT NULL DEFAULT '{}',
    dirty_fields TEXT NOT NULL DEFAULT '[]',
    is_dirty INTEGER NOT NULL DEFAULT 0,
    server_version INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE task (
    id TEXT NOT NULL PRIMARY KEY,
    parent_id TEXT,
    routine_id TEXT,
    title TEXT NOT NULL,
    detail TEXT,
    start_not_before TEXT,
    end_not_after TEXT,
    estimated_duration TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    hlc_map TEXT NOT NULL DEFAULT '{}',
    dirty_fields TEXT NOT NULL DEFAULT '[]',
    is_dirty INTEGER NOT NULL DEFAULT 0,
    server_version INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE task_event (
    id TEXT NOT NULL PRIMARY KEY,
    task_id TEXT NOT NULL,
    journal_date TEXT NOT NULL,
    event_type TEXT NOT NULL,
    content TEXT,
    postponed_json TEXT,
    event_time INTEGER NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    server_version INTEGER NOT NULL DEFAULT 0,
    is_dirty INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
);

CREATE TABLE alarm (
    id TEXT NOT NULL PRIMARY KEY,
    task_id TEXT NOT NULL,
    trigger_time INTEGER NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 1,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    hlc_map TEXT NOT NULL DEFAULT '{}',
    dirty_fields TEXT NOT NULL DEFAULT '[]',
    is_dirty INTEGER NOT NULL DEFAULT 0,
    server_version INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE sync_state (
    scope TEXT NOT NULL PRIMARY KEY,
    last_server_version INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE app_preferences (
    id INTEGER NOT NULL PRIMARY KEY,
    title_prefix TEXT,
    default_alarm_lead_minutes INTEGER NOT NULL,
    default_focus_minutes INTEGER NOT NULL,
    default_short_break_minutes INTEGER NOT NULL,
    default_long_break_minutes INTEGER NOT NULL,
    timezone_override TEXT NOT NULL,
    date_format TEXT NOT NULL,
    blank_title_policy TEXT NOT NULL
);

CREATE TABLE preference (
    pref_key TEXT NOT NULL PRIMARY KEY,
    pref_value TEXT,
    value_type TEXT NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    hlc_map TEXT NOT NULL DEFAULT '{}',
    dirty_fields TEXT NOT NULL DEFAULT '[]',
    is_dirty INTEGER NOT NULL DEFAULT 0,
    server_version INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE pomodoro_session (
    id TEXT NOT NULL PRIMARY KEY,
    task_id TEXT,
    phase TEXT NOT NULL,
    state TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    ends_at INTEGER NOT NULL,
    completed_at INTEGER,
    duration_minutes INTEGER NOT NULL,
    note TEXT,
    task_update TEXT NOT NULL DEFAULT 'NONE',
    is_deleted INTEGER NOT NULL DEFAULT 0,
    hlc_map TEXT NOT NULL DEFAULT '{}',
    dirty_fields TEXT NOT NULL DEFAULT '[]',
    is_dirty INTEGER NOT NULL DEFAULT 0,
    server_version INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

selectTaskById:
SELECT * FROM task WHERE id = ?;

selectTasks:
SELECT * FROM task WHERE is_deleted = 0 ORDER BY updated_at DESC, created_at DESC;

selectAllTasks:
SELECT * FROM task ORDER BY updated_at DESC, created_at DESC;

selectDirtyTasks:
SELECT * FROM task WHERE is_dirty = 1 ORDER BY updated_at ASC, created_at ASC;

upsertTask:
INSERT OR REPLACE INTO task(
    id, parent_id, routine_id, title, detail, start_not_before, end_not_after, estimated_duration, is_deleted, hlc_map, dirty_fields, is_dirty, server_version, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectRoutineById:
SELECT * FROM routine WHERE id = ?;

selectAllRoutines:
SELECT * FROM routine ORDER BY updated_at DESC, created_at DESC;

selectActiveRoutines:
SELECT * FROM routine WHERE is_deleted = 0 ORDER BY updated_at DESC, created_at DESC;

selectDirtyRoutines:
SELECT * FROM routine WHERE is_dirty = 1 ORDER BY updated_at ASC, created_at ASC;

upsertRoutine:
INSERT OR REPLACE INTO routine(
    id, template_title, template_detail, recurrence_rule, default_start_not_before, default_estimated_duration, is_active, is_deleted, hlc_map, dirty_fields, is_dirty, server_version, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAlarmById:
SELECT * FROM alarm WHERE id = ?;

selectAllAlarms:
SELECT * FROM alarm ORDER BY updated_at DESC, created_at DESC;

selectActiveAlarms:
SELECT * FROM alarm WHERE is_deleted = 0 ORDER BY trigger_time ASC, created_at ASC;

selectDirtyAlarms:
SELECT * FROM alarm WHERE is_dirty = 1 ORDER BY updated_at ASC, created_at ASC;

upsertAlarm:
INSERT OR REPLACE INTO alarm(
    id, task_id, trigger_time, is_active, is_deleted, hlc_map, dirty_fields, is_dirty, server_version, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTaskEventById:
SELECT * FROM task_event WHERE id = ?;

selectTaskEventsForTask:
SELECT * FROM task_event WHERE task_id = ? ORDER BY event_time DESC, created_at DESC;

selectDirtyTaskEvents:
SELECT * FROM task_event WHERE is_dirty = 1 ORDER BY event_time ASC, created_at ASC;

selectAllTaskEvents:
SELECT * FROM task_event ORDER BY event_time ASC, created_at ASC;

upsertTaskEvent:
INSERT OR REPLACE INTO task_event(
    id, task_id, journal_date, event_type, content, postponed_json, event_time, is_deleted, server_version, is_dirty, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectJournalEntries:
SELECT
    t.id AS task_id,
    t.title AS title,
    e.id AS event_id,
    e.event_type AS event_type,
    e.content AS content,
    e.postponed_json AS postponed_json,
    e.event_time AS event_time,
    e.created_at AS created_at
FROM task_event e
JOIN task t ON e.task_id = t.id
WHERE e.journal_date = ?
  AND e.is_deleted = 0
ORDER BY e.event_time ASC, e.created_at ASC;

selectTaskLatestEvent:
SELECT * FROM task_event
WHERE task_id = ?
  AND is_deleted = 0
ORDER BY event_time DESC, created_at DESC
LIMIT 1;

initSyncState:
INSERT OR IGNORE INTO sync_state(scope, last_server_version)
VALUES (?, 0);

upsertSyncState:
INSERT OR REPLACE INTO sync_state(scope, last_server_version)
VALUES (?, ?);

selectSyncState:
SELECT * FROM sync_state WHERE scope = ?;

hasSyncedRecords:
SELECT CASE WHEN
    EXISTS (SELECT 1 FROM sync_state WHERE last_server_version > 0) OR
    EXISTS (SELECT 1 FROM preference WHERE server_version > 0) OR
    EXISTS (SELECT 1 FROM routine WHERE server_version > 0) OR
    EXISTS (SELECT 1 FROM task WHERE server_version > 0) OR
    EXISTS (SELECT 1 FROM task_event WHERE server_version > 0) OR
    EXISTS (SELECT 1 FROM alarm WHERE server_version > 0) OR
    EXISTS (SELECT 1 FROM pomodoro_session WHERE server_version > 0) OR
    EXISTS (SELECT 1 FROM finance_account WHERE server_version > 0) OR
    EXISTS (SELECT 1 FROM finance_exchange_rate WHERE server_version > 0) OR
    EXISTS (SELECT 1 FROM finance_clearing_group WHERE server_version > 0) OR
    EXISTS (SELECT 1 FROM finance_transaction WHERE server_version > 0) OR
    EXISTS (SELECT 1 FROM finance_split WHERE server_version > 0) OR
    EXISTS (SELECT 1 FROM finance_split_clearing_group WHERE server_version > 0) OR
    EXISTS (SELECT 1 FROM finance_amortization_plan WHERE server_version > 0) OR
    EXISTS (SELECT 1 FROM finance_budget_rule WHERE server_version > 0)
THEN 1 ELSE 0 END;

hasActiveFinanceRecords:
SELECT CASE WHEN
    EXISTS (SELECT 1 FROM finance_transaction WHERE is_deleted = 0) OR
    EXISTS (SELECT 1 FROM finance_split WHERE is_deleted = 0) OR
    EXISTS (SELECT 1 FROM finance_clearing_group WHERE is_deleted = 0) OR
    EXISTS (SELECT 1 FROM finance_split_clearing_group WHERE is_deleted = 0) OR
    EXISTS (SELECT 1 FROM finance_amortization_plan WHERE is_deleted = 0) OR
    EXISTS (SELECT 1 FROM finance_budget_rule WHERE is_deleted = 0) OR
    EXISTS (SELECT 1 FROM finance_exchange_rate WHERE is_deleted = 0)
THEN 1 ELSE 0 END;

softDeleteSyncedFinanceSplitClearingGroups:
UPDATE finance_split_clearing_group
SET is_deleted = 1, is_dirty = 1, dirty_fields = '["deleted"]', hlc_map = ?, updated_at = ?
WHERE server_version > 0 AND is_deleted = 0;

deleteLocalFinanceSplitClearingGroups:
DELETE FROM finance_split_clearing_group WHERE server_version = 0;

softDeleteSyncedFinanceSplits:
UPDATE finance_split
SET is_deleted = 1, is_dirty = 1, dirty_fields = '["deleted"]', hlc_map = ?, updated_at = ?
WHERE server_version > 0 AND is_deleted = 0;

deleteLocalFinanceSplits:
DELETE FROM finance_split WHERE server_version = 0;

softDeleteSyncedFinanceTransactions:
UPDATE finance_transaction
SET is_deleted = 1, is_dirty = 1, dirty_fields = '["deleted"]', hlc_map = ?, updated_at = ?
WHERE server_version > 0 AND is_deleted = 0;

deleteLocalFinanceTransactions:
DELETE FROM finance_transaction WHERE server_version = 0;

softDeleteSyncedFinanceClearingGroups:
UPDATE finance_clearing_group
SET is_deleted = 1, is_dirty = 1, dirty_fields = '["deleted"]', hlc_map = ?, updated_at = ?
WHERE server_version > 0 AND is_deleted = 0;

deleteLocalFinanceClearingGroups:
DELETE FROM finance_clearing_group WHERE server_version = 0;

softDeleteSyncedFinanceAmortizationPlans:
UPDATE finance_amortization_plan
SET is_deleted = 1, is_dirty = 1, dirty_fields = '["deleted"]', hlc_map = ?, updated_at = ?
WHERE server_version > 0 AND is_deleted = 0;

deleteLocalFinanceAmortizationPlans:
DELETE FROM finance_amortization_plan WHERE server_version = 0;

softDeleteSyncedFinanceBudgetRules:
UPDATE finance_budget_rule
SET is_deleted = 1, is_dirty = 1, dirty_fields = '["deleted"]', hlc_map = ?, updated_at = ?
WHERE server_version > 0 AND is_deleted = 0;

deleteLocalFinanceBudgetRules:
DELETE FROM finance_budget_rule WHERE server_version = 0;

softDeleteSyncedFinanceExchangeRates:
UPDATE finance_exchange_rate
SET is_deleted = 1, is_dirty = 1, dirty_fields = '["deleted"]', hlc_map = ?, updated_at = ?
WHERE server_version > 0 AND is_deleted = 0;

deleteLocalFinanceExchangeRates:
DELETE FROM finance_exchange_rate WHERE server_version = 0;

softDeleteSyncedNonDefaultFinanceAccounts:
UPDATE finance_account
SET is_deleted = 1, is_dirty = 1, dirty_fields = '["deleted"]', hlc_map = ?, updated_at = ?
WHERE server_version > 0 AND is_deleted = 0 AND id NOT IN ('acc-root-assets', 'acc-root-liabilities', 'acc-root-income', 'acc-root-expenses', 'acc-root-equity');

deleteLocalNonDefaultFinanceAccounts:
DELETE FROM finance_account
WHERE server_version = 0 AND id NOT IN ('acc-root-assets', 'acc-root-liabilities', 'acc-root-income', 'acc-root-expenses', 'acc-root-equity');

deleteAllPreferences:
DELETE FROM preference;

deleteAllAppPreferences:
DELETE FROM app_preferences;

deleteAllRoutines:
DELETE FROM routine;

deleteAllTasks:
DELETE FROM task;

deleteAllTaskEvents:
DELETE FROM task_event;

deleteAllAlarms:
DELETE FROM alarm;

deleteAllPomodoroSessions:
DELETE FROM pomodoro_session;

deleteAllFinanceSplitClearingGroups:
DELETE FROM finance_split_clearing_group;

deleteAllFinanceSplits:
DELETE FROM finance_split;

deleteAllFinanceTransactions:
DELETE FROM finance_transaction;

deleteAllFinanceAmortizationPlans:
DELETE FROM finance_amortization_plan;

deleteAllFinanceClearingGroups:
DELETE FROM finance_clearing_group;

deleteAllFinanceExchangeRates:
DELETE FROM finance_exchange_rate;

deleteAllFinanceBudgetRules:
DELETE FROM finance_budget_rule;

deleteAllFinanceAccounts:
DELETE FROM finance_account;

selectPreferenceByKey:
SELECT * FROM preference WHERE pref_key = ?;
selectAllPreferences:
SELECT * FROM preference WHERE is_deleted = 0 ORDER BY pref_key ASC;

selectDirtyPreferences:
SELECT * FROM preference WHERE is_dirty = 1 ORDER BY updated_at ASC, created_at ASC;

upsertPreference:
INSERT OR REPLACE INTO preference(
    pref_key,
    pref_value,
    value_type,
    is_deleted,
    hlc_map,
    dirty_fields,
    is_dirty,
    server_version,
    created_at,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAppPreferences:
SELECT * FROM app_preferences WHERE id = 1;

upsertAppPreferences:
INSERT OR REPLACE INTO app_preferences(
    id,
    title_prefix,
    default_alarm_lead_minutes,
    default_focus_minutes,
    default_short_break_minutes,
    default_long_break_minutes,
    timezone_override,
    date_format,
    blank_title_policy
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectPomodoroSessionById:
SELECT * FROM pomodoro_session WHERE id = ?;

selectActivePomodoroSession:
SELECT * FROM pomodoro_session
WHERE is_deleted = 0 AND state = 'ACTIVE'
ORDER BY started_at DESC, created_at DESC
LIMIT 1;

selectRecentPomodoroSessions:
SELECT * FROM pomodoro_session
WHERE is_deleted = 0
ORDER BY updated_at DESC, created_at DESC
LIMIT ?;

selectDirtyPomodoroSessions:
SELECT * FROM pomodoro_session
WHERE is_dirty = 1
ORDER BY updated_at ASC, created_at ASC;

upsertPomodoroSession:
INSERT OR REPLACE INTO pomodoro_session(
    id,
    task_id,
    phase,
    state,
    started_at,
    ends_at,
    completed_at,
    duration_minutes,
    note,
    task_update,
    is_deleted,
    hlc_map,
    dirty_fields,
    is_dirty,
    server_version,
    created_at,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- ====================================================================
-- FINANCE MODULE TABLES & QUERIES
-- ====================================================================

CREATE TABLE finance_account (
    id TEXT NOT NULL PRIMARY KEY,
    path TEXT NOT NULL,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    currency TEXT NOT NULL DEFAULT 'CNY',
    include_in_net_worth INTEGER NOT NULL DEFAULT 1,
    is_pass_through INTEGER NOT NULL DEFAULT 0,
    pass_through_expense_account_id TEXT,
    liquid_tier TEXT NOT NULL DEFAULT 'Liquid',
    statement_day INTEGER,
    due_day INTEGER,
    is_archived INTEGER NOT NULL DEFAULT 0,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    hlc_map TEXT NOT NULL DEFAULT '{}',
    dirty_fields TEXT NOT NULL DEFAULT '[]',
    is_dirty INTEGER NOT NULL DEFAULT 0,
    server_version INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE finance_exchange_rate (
    id TEXT NOT NULL PRIMARY KEY,
    base_currency TEXT NOT NULL,
    quote_currency TEXT NOT NULL,
    rate_date TEXT NOT NULL,
    rate_micros INTEGER NOT NULL,
    source TEXT NOT NULL DEFAULT 'Manual',
    is_deleted INTEGER NOT NULL DEFAULT 0,
    hlc_map TEXT NOT NULL DEFAULT '{}',
    dirty_fields TEXT NOT NULL DEFAULT '[]',
    is_dirty INTEGER NOT NULL DEFAULT 0,
    server_version INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE finance_transaction (
    id TEXT NOT NULL PRIMARY KEY,
    tx_date TEXT NOT NULL,
    tx_time TEXT,
    payee TEXT,
    summary TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL DEFAULT 'Cleared',
    source_plan_id TEXT,
    period_index INTEGER,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    hlc_map TEXT NOT NULL DEFAULT '{}',
    dirty_fields TEXT NOT NULL DEFAULT '[]',
    is_dirty INTEGER NOT NULL DEFAULT 0,
    server_version INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE finance_split (
    id TEXT NOT NULL PRIMARY KEY,
    transaction_id TEXT NOT NULL,
    account_id TEXT NOT NULL,
    amount_minor INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'CNY',
    weight_amount_minor INTEGER NOT NULL,
    weight_currency TEXT NOT NULL DEFAULT 'CNY',
    narration TEXT NOT NULL DEFAULT '',
    sort_order INTEGER NOT NULL DEFAULT 0,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    hlc_map TEXT NOT NULL DEFAULT '{}',
    dirty_fields TEXT NOT NULL DEFAULT '[]',
    is_dirty INTEGER NOT NULL DEFAULT 0,
    server_version INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE finance_clearing_group (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    group_type TEXT NOT NULL,
    anchor_currency TEXT NOT NULL DEFAULT 'CNY',
    target_account_id TEXT,
    statement_cycle TEXT,
    due_date TEXT,
    status TEXT NOT NULL DEFAULT 'Active',
    settled_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    hlc_map TEXT NOT NULL DEFAULT '{}',
    dirty_fields TEXT NOT NULL DEFAULT '[]',
    is_dirty INTEGER NOT NULL DEFAULT 0,
    server_version INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE finance_split_clearing_group (
    id TEXT NOT NULL PRIMARY KEY,
    split_id TEXT NOT NULL,
    clearing_group_id TEXT NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    hlc_map TEXT NOT NULL DEFAULT '{}',
    dirty_fields TEXT NOT NULL DEFAULT '[]',
    is_dirty INTEGER NOT NULL DEFAULT 0,
    server_version INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Finance Account Queries
selectAllFinanceAccounts:
SELECT * FROM finance_account
WHERE is_deleted = 0
ORDER BY path ASC;

selectFinanceAccountById:
SELECT * FROM finance_account
WHERE id = ?;

selectDirtyFinanceAccounts:
SELECT * FROM finance_account
WHERE is_dirty = 1
ORDER BY updated_at ASC, created_at ASC;

upsertFinanceAccount:
INSERT OR REPLACE INTO finance_account(
    id,
    path,
    name,
    category,
    currency,
    include_in_net_worth,
    is_pass_through,
    pass_through_expense_account_id,
    liquid_tier,
    statement_day,
    due_day,
    is_archived,
    is_deleted,
    hlc_map,
    dirty_fields,
    is_dirty,
    server_version,
    created_at,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Finance Exchange Rate Queries
selectFinanceExchangeRateById:
SELECT * FROM finance_exchange_rate
WHERE id = ?;

selectLatestExchangeRate:
SELECT * FROM finance_exchange_rate
WHERE base_currency = ? AND quote_currency = ? AND rate_date <= ? AND is_deleted = 0
ORDER BY rate_date DESC, updated_at DESC
LIMIT 1;

selectDirtyFinanceExchangeRates:
SELECT * FROM finance_exchange_rate
WHERE is_dirty = 1
ORDER BY updated_at ASC, created_at ASC;

upsertFinanceExchangeRate:
INSERT OR REPLACE INTO finance_exchange_rate(
    id,
    base_currency,
    quote_currency,
    rate_date,
    rate_micros,
    source,
    is_deleted,
    hlc_map,
    dirty_fields,
    is_dirty,
    server_version,
    created_at,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Finance Transaction Queries
selectAllFinanceTransactions:
SELECT * FROM finance_transaction
WHERE is_deleted = 0
ORDER BY tx_date DESC, created_at DESC;

selectFinanceTransactionById:
SELECT * FROM finance_transaction
WHERE id = ?;

selectDirtyFinanceTransactions:
SELECT * FROM finance_transaction
WHERE is_dirty = 1
ORDER BY updated_at ASC, created_at ASC;

upsertFinanceTransaction:
INSERT OR REPLACE INTO finance_transaction(
    id,
    tx_date,
    tx_time,
    payee,
    summary,
    status,
    source_plan_id,
    period_index,
    is_deleted,
    hlc_map,
    dirty_fields,
    is_dirty,
    server_version,
    created_at,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Finance Split Queries
selectFinanceSplitsForTransaction:
SELECT * FROM finance_split
WHERE transaction_id = ? AND is_deleted = 0
ORDER BY sort_order ASC, created_at ASC;

selectFinanceSplitsForAccount:
SELECT * FROM finance_split
WHERE account_id = ? AND is_deleted = 0
ORDER BY created_at DESC;

selectFinanceSplitsForClearingGroup:
SELECT s.* FROM finance_split s
JOIN finance_split_clearing_group scg ON scg.split_id = s.id AND scg.is_deleted = 0
WHERE scg.clearing_group_id = ? AND s.is_deleted = 0
ORDER BY s.created_at ASC;

selectAllActiveFinanceSplits:
SELECT * FROM finance_split
WHERE is_deleted = 0
ORDER BY sort_order ASC, created_at ASC;

selectFinanceSplitById:
SELECT * FROM finance_split
WHERE id = ?;

selectDirtyFinanceSplits:
SELECT * FROM finance_split
WHERE is_dirty = 1
ORDER BY updated_at ASC, created_at ASC;

upsertFinanceSplit:
INSERT OR REPLACE INTO finance_split(
    id,
    transaction_id,
    account_id,
    amount_minor,
    currency,
    weight_amount_minor,
    weight_currency,
    narration,
    sort_order,
    is_deleted,
    hlc_map,
    dirty_fields,
    is_dirty,
    server_version,
    created_at,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Finance Clearing Group Queries
selectAllFinanceClearingGroups:
SELECT * FROM finance_clearing_group
WHERE is_deleted = 0
ORDER BY updated_at DESC, created_at DESC;

selectFinanceClearingGroupById:
SELECT * FROM finance_clearing_group
WHERE id = ?;

selectDirtyFinanceClearingGroups:
SELECT * FROM finance_clearing_group
WHERE is_dirty = 1
ORDER BY updated_at ASC, created_at ASC;

upsertFinanceClearingGroup:
INSERT OR REPLACE INTO finance_clearing_group(
    id,
    name,
    group_type,
    anchor_currency,
    target_account_id,
    statement_cycle,
    due_date,
    status,
    settled_at,
    is_deleted,
    hlc_map,
    dirty_fields,
    is_dirty,
    server_version,
    created_at,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Finance Split Clearing Group Link Queries
selectClearingGroupsForSplit:
SELECT cg.* FROM finance_clearing_group cg
JOIN finance_split_clearing_group scg ON scg.clearing_group_id = cg.id AND scg.is_deleted = 0
WHERE scg.split_id = ? AND cg.is_deleted = 0;

selectAllActiveFinanceSplitClearingGroups:
SELECT * FROM finance_split_clearing_group
WHERE is_deleted = 0;

selectFinanceSplitClearingGroupById:
SELECT * FROM finance_split_clearing_group
WHERE id = ?;

selectDirtyFinanceSplitClearingGroups:
SELECT * FROM finance_split_clearing_group
WHERE is_dirty = 1
ORDER BY updated_at ASC, created_at ASC;

upsertFinanceSplitClearingGroup:
INSERT OR REPLACE INTO finance_split_clearing_group(
    id,
    split_id,
    clearing_group_id,
    is_deleted,
    hlc_map,
    dirty_fields,
    is_dirty,
    server_version,
    created_at,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Finance Amortization Plan Table
CREATE TABLE finance_amortization_plan (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    principal_minor INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'CNY',
    total_periods INTEGER NOT NULL,
    repayment_method TEXT NOT NULL,
    annual_rate_bps INTEGER NOT NULL DEFAULT 0,
    fee_per_period_minor INTEGER NOT NULL DEFAULT 0,
    start_date TEXT NOT NULL,
    repayment_day INTEGER NOT NULL,
    liability_account_id TEXT NOT NULL,
    funding_account_id TEXT,
    interest_account_id TEXT NOT NULL,
    lifecycle_clearing_group_id TEXT NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    hlc_map TEXT NOT NULL DEFAULT '{}',
    dirty_fields TEXT NOT NULL DEFAULT '[]',
    is_dirty INTEGER NOT NULL DEFAULT 0,
    server_version INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX idx_finance_amortization_plan_liability ON finance_amortization_plan(liability_account_id);

-- Finance Amortization Plan Queries
selectAllFinanceAmortizationPlans:
SELECT * FROM finance_amortization_plan
WHERE is_deleted = 0
ORDER BY created_at DESC;

selectFinanceAmortizationPlanById:
SELECT * FROM finance_amortization_plan
WHERE id = ?;

selectDirtyFinanceAmortizationPlans:
SELECT * FROM finance_amortization_plan
WHERE is_dirty = 1
ORDER BY updated_at ASC, created_at ASC;

upsertFinanceAmortizationPlan:
INSERT OR REPLACE INTO finance_amortization_plan(
    id,
    name,
    principal_minor,
    currency,
    total_periods,
    repayment_method,
    annual_rate_bps,
    fee_per_period_minor,
    start_date,
    repayment_day,
    liability_account_id,
    funding_account_id,
    interest_account_id,
    lifecycle_clearing_group_id,
    is_deleted,
    hlc_map,
    dirty_fields,
    is_dirty,
    server_version,
    created_at,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Finance Budget Rule Table
CREATE TABLE finance_budget_rule (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    scope_type TEXT NOT NULL,
    account_prefix TEXT NOT NULL DEFAULT 'Expenses:',
    excluded_prefixes_json TEXT NOT NULL DEFAULT '[]',
    monthly_limit_minor INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'CNY',
    include_in_runway INTEGER NOT NULL DEFAULT 1,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    hlc_map TEXT NOT NULL DEFAULT '{}',
    dirty_fields TEXT NOT NULL DEFAULT '[]',
    is_dirty INTEGER NOT NULL DEFAULT 0,
    server_version INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Finance Budget Rule Queries
selectAllFinanceBudgetRules:
SELECT * FROM finance_budget_rule
WHERE is_deleted = 0
ORDER BY created_at ASC;

selectFinanceBudgetRuleById:
SELECT * FROM finance_budget_rule
WHERE id = ?;

selectDirtyFinanceBudgetRules:
SELECT * FROM finance_budget_rule
WHERE is_dirty = 1
ORDER BY updated_at ASC, created_at ASC;

upsertFinanceBudgetRule:
INSERT OR REPLACE INTO finance_budget_rule(
    id,
    name,
    scope_type,
    account_prefix,
    excluded_prefixes_json,
    monthly_limit_minor,
    currency,
    include_in_runway,
    is_deleted,
    hlc_map,
    dirty_fields,
    is_dirty,
    server_version,
    created_at,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);


